[run]
source = zc.buildout
parallel = true
# The debugging tests drop into pdb, which installs its own trace function.
disable_warnings = trace-changed
omit =
    # Coverage measures the library, not the test code: skip the whole
    # tests package (legacy harness modules, the ported pytests suite,
    # gen_pytest/inject_prose) in both suites. The pattern also covers
    # the fake-release egg copies the update tests install.
    */tests/*
    # _package_index.py vendors setuptools' package index client. The
    # move to uv for package discovery and downloads makes it dead
    # code, so both reports exclude it: measuring code scheduled for
    # removal teaches nothing.
    */_package_index.py

[paths]
# The update tests package the current source as fake-release eggs
# (zc.buildout-91.0, zc.buildout-99.99) and run them from sample
# buildouts. Fold those copies back onto the real source tree.
source =
    src/zc/buildout
    */eggs/v5/zc.buildout-*.egg/zc/buildout

[report]
exclude_lines =
    pragma: no cover
    if __name__ == '__main__':
    raise NotImplementedError
